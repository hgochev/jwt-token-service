{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    ["@semantic-release/exec", {
      "prepareCmd": "sed -i 's/^appVersion: .*/appVersion: \"${nextRelease.version}\"/' deploy/helm/jwt-token-service/Chart.yaml && sed -i 's/^version: .*/version: ${nextRelease.version}/' deploy/helm/jwt-token-service/Chart.yaml"
    }],
    ["@semantic-release/git", {
      "assets": ["CHANGELOG.md", "deploy/helm/jwt-token-service/Chart.yaml"],
      "message": "chore(release): ${nextRelease.version} [skip ci]"
    }],
    "@semantic-release/github"
  ]
}
